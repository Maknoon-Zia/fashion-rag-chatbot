# ---------- Copy this file to .env and fill in YOUR values. Never commit .env ----------

# MongoDB Atlas (Connect > Drivers > copy the mongodb+srv:// string, replace <db_password>)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=fashion_chatbot

# Qdrant Cloud (cluster URL + API key) or a local server such as http://localhost:6333
QDRANT_URL=https://<your-cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_COLLECTION=fashion_knowledge

# Google AI Studio key (embeddings)
GEMINI_API_KEY=<your-gemini-api-key>
EMBEDDING_MODEL=gemini-embedding-001
# If you change the model or dimensions you MUST re-index: python -m scripts.ingest --recreate
EMBEDDING_DIMENSIONS=768

# Groq key (answer generation)
GROQ_API_KEY=<your-groq-api-key>
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900

# Auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-a-random-string-of-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG tuning
CHUNK_MAX_TOKENS=400
CHUNK_MIN_TOKENS=80
CHUNK_OVERLAP_TOKENS=40
EMBED_BATCH_SIZE=16
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=10
RETRIEVAL_MAX_PER_DOCUMENT=2
# Cosine-similarity cut-off. UNCALIBRATED default: tune it with  python -m scripts.eval_retrieval
MIN_RELEVANCE_SCORE=0.55
HISTORY_MESSAGES=6

# Limits
MAX_MESSAGE_CHARS=2000
